# ==============================================================================
# RouteMate AI — Global Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit real production secrets, API keys, or credentials to version control.

# Application Environment ('development' | 'staging' | 'production')
ROUTEMATE_ENV=development

# Core Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://adarshbandaru.github.io

# JWT Authentication (Generate a 64+ char random hex key in production)
JWT_SECRET=replace_with_strong_random_jwt_secret_minimum_64_characters_in_production
SESSION_EXPIRY_SECONDS=86400
OTP_EXPIRY_SECONDS=600
ROUTEMATE_ALLOW_DEV_OTP=true

# Payment Gateway Configuration (Razorpay)
# For sandbox testing, use test keys from Razorpay dashboard: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_key
RAZORPAY_SANDBOX_MODE=true

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SOCKET_URL=http://127.0.0.1:8000
