# ==============================================================================
# RouteMate AI — Backend Environment Template
# ==============================================================================
ROUTEMATE_ENV=development

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://adarshbandaru.github.io

# Security & Authentication
JWT_SECRET=replace_with_strong_random_jwt_secret_in_production
SESSION_EXPIRY_SECONDS=86400
OTP_EXPIRY_SECONDS=600
ROUTEMATE_ALLOW_DEV_OTP=true

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_key
RAZORPAY_SANDBOX_MODE=true
